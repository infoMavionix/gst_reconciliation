APP_NAME=GST Reconciliation API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=mysql+pymysql://gst_app:change_this_app_password@127.0.0.1:3306/gst_reconciliation?charset=utf8mb4
CORS_ORIGINS=http://localhost:5173
AUTO_CREATE_TABLES=true

# Razorpay: use TEST keys during development. Never expose KEY_SECRET in React.
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME
RAZORPAY_CURRENCY=INR
FRONTEND_URL=http://localhost:5173
TRIAL_DAYS=60

# Local exploration only: enables a simulated successful payment (no money charged).
# This endpoint is also hard-blocked unless ENVIRONMENT=development.
ENABLE_DEMO_PAYMENTS=true
